{
  "name": "@rescue-heatmap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Intake, correlation and command API. Same image runs the API and the worker.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "worker": "ROLE=worker tsx watch src/worker.ts",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "aid-sites": "tsx src/import-aid-sites.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
