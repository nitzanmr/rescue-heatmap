# Copy to .env for local work. Never commit a real one.
# Every value here is also the full list of what has to be set on Cloud Run,
# on a Cloudflare container, or on a UNGRD server — the image reads nothing else.

# api | worker | migrate   (one image, three roles)
ROLE=api
NODE_ENV=development
PORT=8080

# Pooled connection for the app (Supabase: port 6543, Neon: the -pooler host).
DATABASE_URL=postgres://rescue:rescue@localhost:5432/rescue
# Direct connection for migrations only. DDL through a transaction pooler fails
# in ways that are hard to diagnose at 3 a.m.
DATABASE_DIRECT_URL=postgres://rescue:rescue@localhost:5432/rescue
DB_POOL_MAX=8

# Durable secrets, NOT config. Rotating TOKEN_PEPPER invalidates every family's
# private link, permanently, and we cannot re-issue them.
TOKEN_PEPPER=change-me-32-random-bytes
IP_PEPPER=change-me-32-random-bytes

# memory | fs | s3   (s3 = Cloudflare R2 / AWS S3 / MinIO)
STORAGE_DRIVER=fs
STORAGE_ROOT_DIR=/data/media
STORAGE_BUCKET=rescue-media
# R2: https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Must not be "*" in production — the intake endpoint is unauthenticated.
CORS_ORIGINS=*

RL_INTAKE_PER_HOUR=20
RL_SEARCH_PER_MINUTE=30
RL_SIGHTING_PER_HOUR=30
PHOTO_MAX_BYTES=3145728

# ADR-001: the public listing expires, the operational record does not.
PUBLIC_RETENTION_DAYS=30
MEDIA_RETENTION_DAYS=90

WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000

# Stage 2. Leave empty and the worker marks vectors 'skipped'; pg_trgm + FTS +
# structured signals carry correlation without them.
EMBEDDINGS_URL=
EMBEDDINGS_TOKEN=
EMBEDDINGS_MODEL=

# Seeding (local / drill only — synthetic data, no real people)
SEED_CASES=500
SEED_DUP_RATE=0.3
SEED_INCIDENT=drill-bogota
